Bootstrap: docker
From: quay.io/rockylinux/rockylinux:9.4
%help
    dix-seq: An integrated pipeline for fast amplicon data analysis.
    version: 1.0.0.a
%labels
    Author: LEI ZHANG, Ziliang Zhang
    Contact: zhanglei@logictek.cn, zlzhang22@outlook.com
%runscript
    dix-seq
%post
    dnf install epel-release -y
    dnf --enablerepo=crb,epel install -y which wget parallel gcc gcc-gfortran xz-lzma-compat \
        xz-libs xz-devel libicu flexiblas flexiblas-devel harfbuzz harfbuzz-devel ImageMagick \
        glpk java-17-openjdk-devel python python-devel perl perl-Switch ImageMagick-perl \
        perl-CPAN perl-DB_File perl-open perl-autodie perl-Env perl-XML-SAX perl-XML-LibXML git
    # 安装依赖
    dnf install -y tar gzip libcurl-devel readline-devel bzip2-devel gcc-c++ make cmake \
        autoconf libtool automake bison flex zlib-devel
    dnf install -y libX11-devel libXt-devel libXmu-devel libSM-devel libICE-devel
    dnf install -y openssl-devel cairo-devel libjpeg-turbo-devel libtiff-devel libpng-devel \
        freetype-devel fontconfig-devel harfbuzz-devel fribidi fribidi-devel pkgconfig
    # 编译安装 R 4.2.2
    mkdir /opt/tools && cd /opt/tools
    wget https://cran.r-project.org/src/base/R-4/R-4.2.2.tar.gz && tar -xzf R-4.2.2.tar.gz && rm R-4.2.2.tar.gz && cd R-4.2.2
    ./configure --prefix=/opt/tools/R-4.2.2 --enable-R-shlib
    make -j$(nproc) && make install
    cd ..
    export R_HOME=/opt/tools/R-4.2.2/lib64/R
    export LD_LIBRARY_PATH=/opt/tools/R-4.2.2/lib64/R/lib/:$LD_LIBRARY_PATH
    export PATH=/opt/tools/R-4.2.2/lib64/R/bin:$PATH
    export PKG_CPPFLAGS="-I/usr/include/freetype2"
    export PKG_LIBS="-lfreetype"
    wget https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.3.2.tar.gz && tar xvf libwebp-1.3.2.tar.gz && rm libwebp-1.3.2.tar.gz && cd libwebp-1.3.2
      ./configure --prefix=/opt/libwebp
      make && make install
      export PKG_CONFIG_PATH=/opt/libwebp/lib/pkgconfig:$PKG_CONFIG_PATH
      cd ..
    #Rscript -e "install.packages(c('ragg','tidyverse'), repos = 'https://cloud.r-project.org')"
    Rscript -e "install.packages(c('ragg', 'Cairo', 'RColorBrewer', 'Rmisc', 'colorspace', 'dendextend', 'docopt', 'ellipse', 'ggplot2', 'ggrepel', 'remotes', 'pheatmap', 'plyr', 'tidyverse', 'vegan', 'viridis', 'gdtools', 'systemfonts'), repos = 'https://cloud.r-project.org')"
    Rscript -e "remotes::install_git('https://codeberg.org/hrbrmstr/hrbrthemes.git')"
    pip install --no-cache --trusted-host mirrors.aliyun.com --no-warn-script-location -i http://mirrors.aliyun.com/pypi/simple/ joblib numpy Cython pkgconfig pandas scipy typing-extensions==3.7.4.3 matplotlib lefse rpy2 biom-format
    # epa-ng-0.3.8
    wget https://github.com/pierrebarbera/epa-ng/archive/refs/tags/v0.3.8.tar.gz && tar -xzvf v0.3.8.tar.gz && rm v0.3.8.tar.gz
        cd epa-ng-0.3.8 && make
        cd ..
    wget https://github.com/lczech/gappa/archive/refs/tags/v0.8.3.tar.gz && tar -xzvf v0.8.3.tar.gz && rm v0.8.3.tar.gz
        cd gappa-0.8.3 && make
        cd ..
    wget http://eddylab.org/software/hmmer/hmmer-3.3.2.tar.gz && tar -xzvf hmmer-3.3.2.tar.gz && rm hmmer-3.3.2.tar.gz
        cd hmmer-3.3.2
        ./configure --prefix=/opt/tools/hmmer-3.3.2
        make && make install
        cd easel && make install
        cd /opt/tools
    wget https://github.com/jgm/pandoc/releases/download/2.14.0.3/pandoc-2.14.0.3-linux-amd64.tar.gz && tar -xzvf pandoc-2.14.0.3-linux-amd64.tar.gz && rm pandoc-2.14.0.3-linux-amd64.tar.gz
    wget https://github.com/marbl/Krona/archive/refs/tags/v2.8.1.tar.gz && tar -xzvf v2.8.1.tar.gz && rm v2.8.1.tar.gz
        cd Krona-2.8.1/KronaTools
        ./install.pl --prefix /opt/tools/Krona-2.8.1
        cd /opt/tools
    git clone https://github.com/mgtools/MinPath.git && mv MinPath MinPath-1.5  # Real:1.6
    wget https://github.com/jameslz/dix-seq/archive/refs/tags/1.0.0.tar.gz && tar -zxvf 1.0.0.tar.gz && rm 1.0.0.tar.gz
    wget https://github.com/picrust/picrust2/archive/refs/tags/v2.5.2.tar.gz && tar -xzvf v2.5.2.tar.gz && pip install picrust2-2.5.2/ && cp -r picrust2-2.5.2/picrust2/default_files /usr/local/lib/python3.9/site-packages/picrust2/ && rm -rf picrust2-2.5.2 v2.5.2.tar.gz
    mkdir usearch-11.0.667 && cd usearch-11.0.667
    git clone https://github.com/rcedgar/usearch_old_binaries.git
    mv usearch_old_binaries/bin/usearch11.0.667_i86linux64 usearch && chmod a+x usearch
    rm usearch_old_binaries -rf
    rm -rf /var/cache/dnf && dnf clean all
%environment
    export LC_ALL=C.UTF-8
    export R_HOME=/opt/tools/R-4.2.2/lib64/R
    export PATH=/opt/tools/R-4.2.2/lib64/R/bin:$PATH
    export LD_LIBRARY_PATH=/opt/tools/R-4.2.2/lib64/R/lib/:$LD_LIBRARY_PATH
    export PATH=/opt/tools/epa-ng-0.3.8/bin:$PATH
    export PATH=/opt/tools/gappa-0.8.3/bin:$PATH
    export PATH=/opt/tools/MinPath-1.5:$PATH
    export PATH=/opt/tools/hmmer-3.3.2/bin:$PATH
    export PATH=/opt/tools/dix-seq-1.0.0:$PATH
    export PATH=/opt/tools/KronaTools-2.8.1/bin:$PATH
    export PATH=/opt/tools/pandoc-2.14.0.3/bin:$PATH
    export PATH=/opt/tools/usearch-11.0.667:$PATH

